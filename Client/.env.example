# Browser calls use the Next.js rewrite by default.
NEXT_PUBLIC_API_URL=/api

# Server-side rewrite target for /api/*.
SERVER_API_URL=https://your-backend-domain.com/api

NEXT_PUBLIC_FIREBASE_API_KEY=your-firebase-web-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-firebase-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=your-app-id

NEXT_PUBLIC_IMGBB_API_KEY=your-imgbb-api-key
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
NEXT_PUBLIC_BKASH_PAYMENT_NUMBER=01878305319
NEXT_PUBLIC_NAGAD_PAYMENT_NUMBER=01878305319
